    {
      "id": 11,
      "type": "timeseries",
      "title": "Historico: temperatura promedio y p95 por hora (mv_resumen_hora)",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "iot-pg"
      },
      "gridPos": {
        "x": 12,
        "y": 22,
        "w": 12,
        "h": 9
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "iot-pg"
          },
          "rawQuery": true,
          "editorMode": "code",
          "format": "time_series",
          "rawSql": "SELECT hora AS time, sensor || ' promedio' AS metric, promedio AS value\nFROM mv_resumen_hora\nWHERE tipo = 'temperatura' AND $__timeFilter(hora)\nUNION ALL\nSELECT hora, sensor || ' p95', p95\nFROM mv_resumen_hora\nWHERE tipo = 'temperatura' AND $__timeFilter(hora)\nORDER BY 1"
        }
      ],
      "timeFrom": "3d",
      "fieldConfig": {
        "defaults": {
          "unit": "celsius",
          "custom": {
            "lineWidth": 1
          }
        },
