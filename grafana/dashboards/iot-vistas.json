          "editorMode": "code",
          "format": "time_series",
          "rawSql": "SELECT minuto AS time, sensor AS metric, promedio AS value\nFROM v_tendencia_24h\nWHERE tipo = 'temperatura' AND $__timeFilter(minuto)\nORDER BY 1"
